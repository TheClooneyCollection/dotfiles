{
  "permissions": {
    "allow": [
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(git:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(wc:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(maestri:*)",
      "Bash(tmux-ask:*)",
      "Bash(tmux-notes:*)",
      "Bash(tmux-peers:*)",
      "Bash(tmux-peek:*)",
      "Bash(tmux-spawn:*)",
      "Bash(tmux-connect --from:*)",
      "Bash(tmux-agent-report:*)",
      "Bash(tmux-dismiss --from:*)",
      "Bash(tmux-rename --from:*)",
      "Bash(tmux-agents chain-config:*)",
      "Bash(~/.bin/tmux/tmux-ask:*)",
      "Bash(~/.bin/tmux/tmux-notes:*)",
      "Bash(~/.bin/tmux/tmux-peers:*)",
      "Bash(~/.bin/tmux/tmux-peek:*)",
      "Bash(~/.bin/tmux/tmux-spawn:*)",
      "Bash(~/.bin/tmux/tmux-connect --from:*)",
      "Bash(~/.bin/tmux/tmux-agent-report:*)",
      "Bash(~/.bin/tmux/tmux-dismiss --from:*)",
      "Read"
    ],
    "deny": [
      "Agent",
      "Artifact",
      "ScheduleWakeup",
      "Workflow"
    ]
  },
  "model": "opus",
  "hooks": {
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "printf '\\a'"
          }
        ]
      },
      {
        "matcher": "idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "printf '\\a'"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "sh ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "swift-lsp@claude-plugins-official": false,
    "codex@openai-codex": false
  },
  "extraKnownMarketplaces": {
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    }
  },
  "effortLevel": "low",
  "modelSettings": {
    "gpt-6-astra": {
      "effortLevel": "medium"
    }
  },
  "autoCompactWindow": 250000,
  "tui": "fullscreen",
  "theme": "dark-ansi",
  "autoCompactEnabled": true,
  "agentPushNotifEnabled": true,
  "voiceEnabled": true,
  "env": {
    "ENABLE_CLAUDEAI_MCP_SERVERS": "false"
  },
  "skillOverrides": {
    "artifact-capabilities": "off",
    "artifact-design": "off",
    "artifact-diagramming": "off",
    "workflow-authoring": "off",
    "anthropic-skills:deep-research": "off",
    "anthropic-skills:docs": "user-invocable-only",
    "anthropic-skills:pptx": "user-invocable-only",
    "anthropic-skills:xlsx": "user-invocable-only",
    "anthropic-skills:docx": "user-invocable-only",
    "anthropic-skills:pdf": "user-invocable-only",
    "anthropic-skills:google-workspace": "user-invocable-only",
    "anthropic-skills:computer-use": "user-invocable-only",
    "anthropic-skills:built-in-browser": "user-invocable-only",
    "anthropic-skills:chrome-browser": "user-invocable-only",
    "anthropic-skills:morning": "user-invocable-only",
    "anthropic-skills:skill-creator": "user-invocable-only",
    "anthropic-skills:import-memory": "user-invocable-only",
    "dataviz": "user-invocable-only",
    "code-review": "user-invocable-only",
    "claude-in-chrome": "user-invocable-only",
    "schedule": "user-invocable-only",
    "loop": "user-invocable-only",
    "run": "user-invocable-only",
    "plugin-authoring": "user-invocable-only",
    "keybindings-help": "user-invocable-only",
    "fewer-permission-prompts": "user-invocable-only",
    "simplify": "user-invocable-only",
    "security-review": "user-invocable-only",
    "init": "user-invocable-only"
  }
}
