{
  "permissions": {
    "allow": [
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(git:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(wc:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(maestri:*)",
      "Bash(tmux-ask:*)",
      "Bash(tmux-peers:*)",
      "Bash(tmux-peek:*)",
      "Bash(tmux-spawn:*)",
      "Bash(tmux-connect --from:*)",
      "Bash(tmux-agent-report:*)",
      "Bash(tmux-dismiss --from:*)",
      "Bash(~/.bin/tmux/tmux-ask:*)",
      "Bash(~/.bin/tmux/tmux-peers:*)",
      "Bash(~/.bin/tmux/tmux-peek:*)",
      "Bash(~/.bin/tmux/tmux-spawn:*)",
      "Bash(~/.bin/tmux/tmux-connect --from:*)",
      "Bash(~/.bin/tmux/tmux-agent-report:*)",
      "Bash(~/.bin/tmux/tmux-dismiss --from:*)",
      "Read"
    ]
  },
  "model": "opus",
  "hooks": {
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "printf '\\a'"
          }
        ]
      },
      {
        "matcher": "idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "printf '\\a'"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "sh ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "swift-lsp@claude-plugins-official": true,
    "codex@openai-codex": true
  },
  "extraKnownMarketplaces": {
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    }
  },
  "effortLevel": "low",
  "theme": "dark-ansi",
  "agentPushNotifEnabled": true,
  "voiceEnabled": true
}
