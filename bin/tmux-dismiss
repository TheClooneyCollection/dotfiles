#!/usr/bin/env bash
# Close an agent and its descendants, retaining resumable session records.
set -euo pipefail
. "$(dirname "$0")/lib.sh"

FROM_PANE=""
keep_children=0
done_only=0
target=""
usage() {
  echo "usage: tmux-dismiss [--from ME] [--keep-children] <name> | --done"
  echo "Closes the whole subtree deepest first; session records are kept for --resume."
}
while [ "$#" -gt 0 ]; do
  case "$1" in
    --from) [ "$#" -ge 2 ] && [ -n "$2" ] || die "--from needs an agent"; FROM_PANE="$2"; shift 2 ;;
    --keep-children) keep_children=1; shift ;;
    --done) done_only=1; shift ;;
    -h|--help) usage; exit 0 ;;
    -*) die "unknown option '$1'" ;;
    *) [ -z "$target" ] || die "only one agent name is allowed"; target="$1"; shift ;;
  esac
done
if [ "$done_only" -eq 1 ]; then
  [ -z "$target" ] || die "--done cannot take an agent name"
else
  [ -n "$target" ] || { usage; exit 1; }
fi
require_tmux
closer=""
[ -z "$FROM_PANE" ] || closer="$(self_pane)"

close_pane() {
  local pane="$1" name child
  pane_alive "$pane" || return 0
  name="$(pane_name "$pane")"
  if [ "$keep_children" -eq 1 ]; then
    for child in $(tmux list-panes -a -F '#{pane_id} #{@parent}' | awk -v p="$pane" '$2 == p {print $1}'); do
      pane_alive "$child" || continue
      tmux set-option -pu -t "$child" @parent
    done
  fi
  note_closed "$pane" "$closer"
  record_closed "$pane"
  tmux kill-pane -t "$pane"
  echo "dismissed ${name:-unnamed} ($pane)"
}

if [ "$done_only" -eq 1 ]; then
  candidates="$(tmux list-panes -a -F '#{pane_id} #{@parent}' | awk 'NF == 2 && !seen[$1]++ {print $1}')"
  selected=" "
  for pane in $candidates; do
    pane_finished "$pane" || continue
    [ -z "$closer" ] || pane_is_descendant "$pane" "$closer" || continue
    subtree="$(pane_subtree "$pane")" || continue
    blocked=""
    for child in $subtree; do
      if ! pane_finished "$child"; then blocked="${blocked:+$blocked, }$(pane_name "$child") ($child)"; fi
    done
    if [ -n "$blocked" ]; then
      echo "skipped $(pane_name "$pane") ($pane): subtree has unfinished agents: $blocked"
      continue
    fi
    [ "$keep_children" -eq 0 ] || subtree="$pane"
    for child in $subtree; do
      case "$selected" in *" $child "*) ;; *) selected="$selected$child " ;; esac
    done
  done
  if [ "$selected" = " " ]; then
    echo "No done or exited sub agents eligible to close."
    exit 0
  fi
  # Sort the union by ancestry, so overlapping candidates still close once,
  # deepest first (also when --keep-children selects finished parent/child).
  ordered=""
  for pane in $selected; do
    for child in $(pane_subtree "$pane"); do
      case "$selected" in *" $child "*)
        case " $ordered " in *" $child "*) ;; *) ordered="${ordered:+$ordered }$child" ;; esac ;;
      esac
    done
  done
  echo "Dismiss these agents and their transcripts? (Session records are kept.)"
  for pane in $ordered; do printf '  %s (%s)\n' "$(pane_name "$pane")" "$pane"; done
  printf 'Close %s pane(s)? [y/N] ' "$(printf '%s\n' "$ordered" | wc -w | tr -d ' ')"
  read -r answer </dev/tty || answer=""
  case "$answer" in y|Y|yes) ;; *) echo "Nothing closed."; exit 0 ;; esac
  for pane in $ordered; do close_pane "$pane"; done
else
  pane="$(find_pane "$target")"
  [ -n "$pane" ] && pane_alive "$pane" || die "no agent named '$target'"
  if [ -n "$closer" ]; then
    pane_is_descendant "$pane" "$closer" \
      || die "'$target' is not your descendant; you can only close your sub agents and their descendants"
  fi
  if [ "$keep_children" -eq 1 ]; then panes="$pane"; else panes="$(pane_subtree "$pane")"; fi
  for pane in $panes; do close_pane "$pane"; done
fi
refresh_labels
