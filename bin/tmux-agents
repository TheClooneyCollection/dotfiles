#!/usr/bin/env bash
# Browse agent panes: live preview, open hidden ones in a popup, jump, dismiss.
set -euo pipefail
here="$(cd "$(dirname "$0")" && pwd)"
. "$here/lib.sh"

usage() {
  cat <<'EOF'
usage: tmux-agents [--client NAME]

Lists sub agents (spawned with tmux-spawn) with a live preview.
Bound to prefix + a.

  enter   open it: hidden agents in a popup (prefix + d closes), others jump
  ctrl-o  jump to it full screen (prefix + L jumps back)
  ctrl-x  dismiss (close its subtree)
  ctrl-d  clean up wholly done or exited subtrees (asks first)
  ctrl-a  toggle between sub agents and every named pane
  ctrl-t  toggle between this window and all windows
  ctrl-r  refresh
EOF
}

# Both view dimensions travel in FZF_PROMPT during reloads, not global scope.
list_prompt() {
  local label=agents scope='this window'
  [ "$1" != all ] || label=all
  [ "$2" != all ] || scope='all windows'
  printf '%s · %s> ' "$label" "$scope"
}
parse_prompt() {
  list_mode=sub list_scope=window
  case "$1" in all*) list_mode=all ;; esac
  case "$1" in *'all windows>'*) list_scope=all ;; esac
}

# Snapshot the parent graph, then grow the set from this window's panes.
# Missing parents and cycles cannot loop forever. Include unnamed ancestors.
window_members() {
  local window
  if [ -n "${1:-}" ]; then
    window="$(tmux list-clients -F '#{client_name} #{window_id}' | awk -v c="$1" '$1 == c {print $2; exit}')"
  else
    window="$(tmux display-message -p ${TMUX_PANE:+-t "$TMUX_PANE"} '#{window_id}')"
  fi
  [ -n "$window" ] || return 0
  tmux list-panes -a -F '#{pane_id} #{?@parent,#{@parent},-} #{window_id}' | awk -v w="$window" '
    { parent[$1]=$2; if ($3 == w) member[$1]=1 }
    END {
      do { changed=0
        for (p in parent) if (!member[p] && member[parent[p]]) { member[p]=1; changed=1 }
      } while (changed)
      for (p in member) if (member[p]) printf "%s ", p
    }'
}
in_list_window() { case " $list_members " in *" $1 "*) return 0 ;; *) return 1 ;; esac; }

# A hidden pane's useful location is its first visible ancestor's window.
# Splits already have that location. Keep the original if the chain is broken
# or entirely hidden; guard cycles in stale parent links too.
attention_window() {
  tmux list-panes -a -F '#{pane_id}	#{?@parent,#{@parent},-}	#{session_name}	#{session_name}:#{window_index}' | awk -F '\t' \
    -v pane="$1" -v fallback="$2" -v prefix="$AGENTS_PREFIX-" '
    { parent[$1]=$2; session[$1]=$3; location[$1]=$4 }
    END {
      while ((pane in parent) && !seen[pane]++) {
        if (index(session[pane], prefix) != 1) { print location[pane]; exit }
        pane=parent[pane]
      }
      print fallback
    }'
}

# Closed ancestors have names in session records rather than live pane ids.
# Stop at the first live ancestor, then use the same visible owner as pins.
closed_record_window() {
  local name="$1" pane location seen=$'\n'
  while [ -n "$name" ]; do
    case "$seen" in *$'\n'"$name"$'\n'*) return 0 ;; esac
    seen="$seen$name"$'\n'
    pane="$(find_pane "$name")"
    if [ -n "$pane" ]; then
      location="$(tmux display-message -p -t "$pane" '#{session_name}:#{window_index}')"
      location="$(attention_window "$pane" "$location")"
      tmux display-message -p -t "$location" '#{window_id}'
      return 0
    fi
    name="$(record_get "$name" parent)"
  done
}

# Sub agents that were closed in the last TMUX_AGENTS_RESUME_DAYS (default
# 7) and can be reopened, as list_agents rows: rank, section, "closed:NAME",
# name, status, parent, "project · closed 5m ago". Newest first; older
# records are deleted. A record whose name has a live pane isn't closed.
closed_agents() {
  local dir now keep f name id at age section owner_window window n=0 rows="" tab nl=$'\n'
  dir="$(sessions_dir)"
  [ -d "$dir" ] || return 0
  if [ "${list_scope:-all}" != all ]; then
    if [ -n "${1:-}" ]; then
      window="$(tmux list-clients -F '#{client_name} #{window_id}' | awk -v c="$1" '$1 == c {print $2; exit}')"
    else
      window="$(tmux display-message -p ${TMUX_PANE:+-t "$TMUX_PANE"} '#{window_id}')"
    fi
    [ -n "$window" ] || return 0
  fi
  tab="$(printf '\t')"
  now="$(date +%s)" keep=$(( ${TMUX_AGENTS_RESUME_DAYS:-7} * 86400 ))
  for f in "$dir"/*; do
    [ -f "$f" ] || continue
    name="$(basename "$f")"
    at="$(record_get "$name" closed)"
    [ -n "$at" ] || at="$(stat -f %m "$f" 2>/dev/null || stat -c %Y "$f")"
    if [ $((now - at)) -gt "$keep" ]; then rm -f "$f"; continue; fi
    [ -z "$(find_pane "$name")" ] || continue
    if [ "${list_scope:-all}" != all ]; then
      owner_window="$(closed_record_window "$(record_get "$name" parent)")"
      [ -n "$owner_window" ] && [ "$owner_window" = "$window" ] || continue
    fi
    id="$(record_get "$name" id)"
    [ -n "$id" ] || continue
    age=$((now - at))
    if [ "$age" -lt 3600 ]; then age="$((age / 60))m"
    elif [ "$age" -lt 86400 ]; then age="$((age / 3600))h"
    else age="$((age / 86400))d"; fi
    section="$(agents_session_for "$(record_get "$name" dir)")"
    # Rank sorts closed agents after every live one, newest first.
    rows="$rows$((20000000000 - at))$tab${section#"$AGENTS_PREFIX"-}$tab$name$tab$(record_get "$name" parent)$tab$age$nl"
    n=$((n + 1))
  done
  [ "$n" -gt 0 ] || return 0
  printf '%s' "$rows" | while IFS="$tab" read -r rank project name parent age; do
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$rank" "closed ($n) · enter reopens" "closed:$name" "$name" "↺ closed" "${parent:--}" "$project · closed $age ago"
  done
}

# One entry per agent: NAME STATUS PARENT, then what it is doing now,
# grouped into a section per project (the first entry of each project
# carries a "▸ project" line on top). Every entry starts with its pane id,
# hidden by fzf, so {1} is the pane. Entries end in \036 (bash strings
# can't hold the NUL fzf --read0 wants; callers convert with tr); the first
# is the header. Sub agents only, unless $1 is "all" (then every named pane).
# Closed sub agents that can be reopened (see closed_agents) come last, in
# their own section, with "closed:NAME" in place of the pane id.
list_agents() {
  local all="${1:-}" rows sorted tab list_scope="${2:-window}" list_members
  local id name dead perm st parent session activity path location attention rank status pname project since
  list_members="$(window_members "${3:-}")"
  tab="$(printf '\t')"
  rows="$(tmux list-panes -a -F '#{pane_id}	#{@agent}	#{pane_dead}	#{?@perm_since,#{@perm_since},-}	#{?@state,#{@state},-}	#{?@parent,#{@parent},-}	#{session_name}	#{?@activity,#{@activity},-}	#{pane_current_path}	#{session_name}:#{window_index}	#{?@attention_since,#{@attention_since},-}' \
    | awk -F '\t' -v all="$all" '$2 != "" && (all == "all" || $6 != "-") && !seen[$1]++')"
  # Same states as the chip. Pinned sub agents sort by waiting time;
  # other project sections sort by their most urgent scoped agent.
  sorted="$(printf '%s\n' "$rows" | while IFS="$tab" read -r id name dead perm st parent session activity path location attention; do
      [ -n "$id" ] || continue
      if [ "$dead" = 1 ]; then rank=5 status="✗ exited"
      elif [ "$perm" != - ]; then rank=0 status="⚠ permission"
      elif [ "$st" = needs_you ]; then rank=1 status="◆ needs you"
      elif [ "$st" = idle ]; then rank=3 status="○ idle"
      elif [ "$st" = done ]; then rank=4 status="✓ done"
      else rank=2 status="⠿ working"
      fi
      pname="-"
      [ "$parent" = "-" ] || pname="$(pane_name "$parent")"
      # Hidden sub agents: the project in the session name. Other panes:
      # the project tmux-spawn would use for their directory.
      if is_agents_session "$session"; then project="${session#"$AGENTS_PREFIX"-}"
      else project="$(agents_session_for "$path")"; project="${project#"$AGENTS_PREFIX"-}"
      fi
      if [ "$parent" != - ] && [ "$dead" != 1 ] && { [ "$perm" != - ] || [ "$st" = needs_you ]; }; then
        since="$attention"; [ "$perm" = - ] || since="$perm"
        [[ $since =~ ^[0-9]+$ ]] || since="$(date +%s)"
        rank=$((since - 20000000000))
        [ "$activity" != - ] || activity='no report yet'
        location="$(attention_window "$id" "$location")"
        activity="$location · $project · $activity"
        project='needs you'
      elif [ "$list_scope" != all ] && ! in_list_window "$id"; then
        continue
      fi
      printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$rank" "$project" "$id" "$name" "$status" "${pname:--}" "$activity"
    done | { cat; closed_agents "${3:-}"; } | awk -F '\t' '{ r[NR] = $0; if (!($2 in best) || $1 < best[$2]) best[$2] = $1; p[NR] = $2 }
      END { for (i = 1; i <= NR; i++) print best[p[i]] "\t" r[i] }' \
    | sort -t "$tab" -k1,1n -k3,3 -k2,2n -s | cut -f3-)"
  # Align NAME STATUS PARENT, then add each entry's id, section and activity.
  { if [ -z "$sorted" ] && [ "$list_scope" != all ]; then printf 'NAME\tSTATUS\tPARENT (ctrl-t: all windows)\n'; else printf 'NAME\tSTATUS\tPARENT\n'; fi; [ -z "$sorted" ] || printf '%s\n' "$sorted" | cut -f3-5; } \
    | column -t -s "$tab" \
    | META="$(printf '%s\n' "$sorted" | cut -f1,2,6 | tr '\n' '\036')" awk '
      BEGIN { n = split(ENVIRON["META"], m, "\036")
        for (i = 1; i <= n; i++) { split(m[i], f, "\t"); P[i] = f[1]; I[i] = f[2]; A[i] = f[3] } }
      # Colour after aligning, so escape codes do not upset the columns.
      NR == 1 { printf "ID %s%c", $0, 30; next }
      { i = NR - 1
        sub(/⚠ permission/, "\033[1;97;41m&\033[0m"); sub(/◆ needs you/, "\033[1;30;48;5;214m&\033[0m");
        sub(/⠿ working/, "\033[38;5;117m&\033[0m"); sub(/○ idle/, "\033[38;5;244m&\033[0m"); sub(/✓ done/, "\033[38;5;114m&\033[0m");
        sub(/✗ exited/, "\033[38;5;240m&\033[0m"); sub(/↺ closed/, "\033[38;5;244m&\033[0m")
        a = A[i]; if (a == "" || a == "-") a = "no report yet"
        sect = ""
        if (P[i] != last) { sect = "\033[1;38;5;180m▸ " P[i] "\033[0m\n"; last = P[i] }
        printf "%s %s%s\n  \033[38;5;245m%s\033[0m%c", I[i], sect, $0, a, 30 }'
}

# Two-line status bar while sub agents exist: the chip line on top, the
# user's own status line below. "on" saves their line in
# @tmux_agents_main_format; "off" puts it back.
chip_layout() {
  local cur main fps
  if [ "$1" = on ]; then
    cur="$(tmux show-options -gv 'status-format[0]')"
    case "$cur" in *"tmux-agents --chip"*|*"@chip"*) ;; *) tmux set-option -g @tmux_agents_main_format "$cur" ;; esac
    main="$(tmux show-options -gqv @tmux_agents_main_format)"
    fps="$(tmux show-options -gqv @tmux_agents_chip_fps)"
    tmux set-option -g 'status-format[1]' "$main"
    if [ "${fps:-10}" -gt 1 ] 2>/dev/null; then
      # Pushed by the chip daemon at $fps frames a second.
      # The #() part prints nothing; it restarts the daemon if it died.
      tmux set-option -g 'status-format[0]' "#{@chip}#($here/tmux-agents --chip-ensure)"
      tmux run-shell -b "'$here/tmux-agents' --chip-daemon"
    else
      # Re-run by tmux every status-interval (1s at most).
      tmux set-option -g 'status-format[0]' "#($here/tmux-agents --chip)"
    fi
    tmux set-option -g status 2
  else
    main="$(tmux show-options -gqv @tmux_agents_main_format)"
    [ -n "$main" ] || return 0
    tmux set-option -g 'status-format[0]' "$main"
    tmux set-option -gu 'status-format[1]'
    tmux set-option -g status on
  fi
}

# One per tmux server, started by chip_layout: rebuild the chip once a
# second, animate its spinner at @tmux_agents_chip_fps (default 10), and
# push it into @chip with a redraw. Exits once the chip line is gone.
chip_daemon() {
  local pid fps delay frames tick=0 last=-1 now template line c log
  pid="$(tmux show-options -gqv @tmux_agents_chip_pid)"
  if [ -n "$pid" ] && [ "$pid" != $$ ] && kill -0 "$pid" 2>/dev/null; then return 0; fi
  tmux set-option -g @tmux_agents_chip_pid $$
  # Two clients' --chip-ensure can start daemons in the same second; the
  # last one to register wins and the others leave.
  sleep 0.3
  [ "$(tmux show-options -gqv @tmux_agents_chip_pid)" = $$ ] || return 0
  # A long-running loop: one failing tmux call (say a client detaching
  # between list-clients and refresh-client) must not end it.
  set +e +o pipefail
  log="/tmp/tmux-agents-$(id -u)/chip-daemon.log"
  mkdir -p "$(dirname "$log")"
  exec 2>>"$log"
  fps="$(tmux show-options -gqv @tmux_agents_chip_fps)"
  case "$fps" in ''|*[!0-9]*) fps=10 ;; esac
  [ "$fps" -le 30 ] || fps=30
  delay="$(awk -v f="$fps" 'BEGIN { printf "%.3f", 1 / f }')"
  frames=(⠋ ⠙ ⠹ ⠸ ⠼ ⠴ ⠦ ⠧ ⠇ ⠏)
  while :; do
    now="$(date +%s)"
    if [ "$now" != "$last" ]; then
      case "$(tmux show-options -gv 'status-format[0]' 2>/dev/null)" in *"@chip"*) ;; *) echo "$(date '+%F %T') chip line gone, exiting" >&2; break ;; esac
      template="$(CHIP_SPIN=@@SPIN@@ chip)"
      last="$now"
    fi
    line="${template//@@SPIN@@/${frames[$((tick % 10))]}}"
    tmux set-option -g @chip "$line" 2>/dev/null || { echo "$(date '+%F %T') tmux server gone, exiting" >&2; break; }
    for c in $(tmux list-clients -F '#{client_name}' 2>/dev/null); do tmux refresh-client -S -t "$c" 2>/dev/null; done
    tick=$((tick + 1))
    sleep "$delay"
  done
  tmux set-option -gu @tmux_agents_chip_pid 2>/dev/null || true
  tmux set-option -gu @chip 2>/dev/null || true
}

# "stone-age" from agents-projects-stone-age, at most 10 characters.
short_project() {
  local p="${1#"$AGENTS_PREFIX"-}"
  p="${p#projects-}"; p="${p#project-}"
  [ "${#p}" -le 10 ] || p="${p:0:9}…"
  printf '%s' "$p"
}

# Long task names keep their start and end: seimu-jyaruga-map-audit -> seimu-j…map-audit
short_task() {
  [ "${#1}" -le 18 ] && { printf '%s' "$1"; return; }
  printf '%s…%s' "${1:0:7}" "${1:$((${#1} - 10))}"
}

# The chip, centred: one focus agent that rotates every 4s, then
# per-project counts. Agents waiting for permission take over the focus and turn red; past
# TMUX_AGENTS_BLINK_SECS (default 60) unanswered, they blink.
chip() {
  local now frames spin rows id name dead st session since activity state act
  local -a ids names states acts projs sinces
  now="$(date +%s)"
  frames=(⠋ ⠙ ⠹ ⠸ ⠼ ⠴ ⠦ ⠧ ⠇ ⠏)
  # CHIP_SPIN lets the chip daemon put a placeholder here and animate it.
  spin="${CHIP_SPIN:-${frames[$((now % 10))]}}"
  rows="$(tmux list-panes -a -F '#{pane_id}	#{@agent}	#{pane_dead}	#{?@state,#{@state},-}	#{session_name}	#{?@perm_since,#{@perm_since},-}	#{?@activity,#{@activity},-}	#{?@parent,1,0}	#{?@attention_since,#{@attention_since},-}' \
    | awk -F '\t' '$8 == 1 && $2 != "" && !seen[$1]++')"
  if [ -z "$rows" ]; then
    [ "$(tmux show-options -gv status)" != 2 ] || tmux run-shell -b "'$here/tmux-agents' --chip-layout off"
    return 0
  fi
  # State comes from what agents report: tmux-agent-report sets @activity,
  # Claude's permission hook sets @perm_since, a reply to the parent sets
  # done, and a turn that ends without either sets needs_you.
  while IFS="$(printf '\t')" read -r id name dead st session since activity _ attention; do
    if [ "$dead" = 1 ]; then
      state=exited act="exited"
    elif [ "$since" != - ]; then
      state=perm act="NEEDS PERMISSION"
    elif [ "$st" = idle ]; then
      state=idle act="idle"
    elif [ "$st" = done ]; then
      state=done act="done"
    elif [ "$st" = needs_you ]; then
      state=needs act="NEEDS YOU" since="$attention"
      [ "$since" != - ] || since="$now"
    else
      state=work act="$activity"
      [ "$act" != - ] || act="starting"
    fi
    ids+=("$id"); names+=("$name"); states+=("$state"); acts+=("$act"); projs+=("$(short_project "$session")"); sinces+=("$since")
  done <<EOF
$rows
EOF

  # Per-project counts, in first-seen order.
  local out="" seen_projs=" " pj i n w d idle pm nd ex seg
  for pj in "${projs[@]}"; do
    case "$seen_projs" in *" $pj "*) continue ;; esac
    seen_projs="$seen_projs$pj "
    w=0 d=0 idle=0 pm=0 nd=0 ex=0
    for ((i = 0; i < ${#ids[@]}; i++)); do
      [ "${projs[i]}" = "$pj" ] || continue
      case "${states[i]}" in work) w=$((w+1)) ;; idle) idle=$((idle+1)) ;; done) d=$((d+1)) ;; perm) pm=$((pm+1)) ;; needs) nd=$((nd+1)) ;; exited) ex=$((ex+1)) ;; esac
    done
    seg="#[fg=colour250]$pj#[default]"
    [ "$pm" -eq 0 ] || seg="$seg #[fg=white,bg=red,bold] ⚠ $pm #[default]"
    [ "$nd" -eq 0 ] || seg="$seg #[fg=black,bg=colour214,bold] ◆ $nd #[default]"
    [ "$w" -eq 0 ] || seg="$seg #[fg=colour117]$spin $w#[default]"
    [ "$idle" -eq 0 ] || seg="$seg #[fg=colour244]○ $idle#[default]"
    [ "$d" -eq 0 ] || seg="$seg #[fg=colour114]✓ $d#[default]"
    [ "$ex" -eq 0 ] || seg="$seg #[fg=colour240]✗ $ex#[default]"
    out="${out:+$out #[fg=colour240]·#[default] }$seg"
  done

  # Focus: rotate through agents that need the user (permission or
  # otherwise) if any, else all.
  local -a cand=()
  for ((i = 0; i < ${#ids[@]}; i++)); do case "${states[i]}" in perm|needs) cand+=("$i") ;; esac; done
  [ ${#cand[@]} -gt 0 ] || for ((i = 0; i < ${#ids[@]}; i++)); do cand+=("$i"); done
  i="${cand[$(( (now / 4) % ${#cand[@]} ))]}"
  local icon style focus
  case "${states[i]}" in
    perm) icon="⚠" ;;
    needs) icon="◆" ;;
    work) icon="$spin" ;;
    idle) icon="○" ;;
    done) icon="✓" ;;
    exited) icon="✗" ;;
    *) icon="◦" ;;
  esac
  focus="$icon $(short_task "${names[i]}"): ${acts[i]}"
  if [ "${states[i]}" = perm ] || [ "${states[i]}" = needs ]; then
    if [ "${states[i]}" = perm ]; then style="fg=white,bg=red,bold"; else style="fg=black,bg=colour214,bold"; fi
    [ $((now - ${sinces[i]})) -lt "${TMUX_AGENTS_BLINK_SECS:-60}" ] || style="$style,blink"
    focus="#[$style] $focus #[default]"
  elif [ "${states[i]}" = idle ]; then
    focus="#[fg=colour244]$focus#[default]"
  else
    focus="#[fg=colour252]$focus#[default]"
  fi
  # Focus, then per-project status, centred on the line.
  printf '#[align=centre]%s  #[fg=colour240]│#[default]  %s' "$focus" "$out"
}

case "${1:-}" in
  -h|--help) usage; exit 0 ;;
  # fzf reloads call this; the prompt says which view is showing.
  --chip) require_tmux; chip; exit 0 ;;
  --chip-layout) require_tmux; chip_layout "${2:-on}"; exit 0 ;;
  --chip-daemon) require_tmux; chip_daemon; exit 0 ;;
  # Run every status-interval from the chip line: restart a dead daemon.
  --chip-ensure)
    pid="$(tmux show-options -gqv @tmux_agents_chip_pid)"
    if [ -z "$pid" ] || ! kill -0 "$pid" 2>/dev/null; then
      tmux run-shell -b "'$here/tmux-agents' --chip-daemon"
    fi
    exit 0
    ;;
  --list) require_tmux; parse_prompt "${FZF_PROMPT:-}"; list_agents "$list_mode" "$list_scope" "${TMUX_AGENTS_LIST_CLIENT:-}" | tr '\036' '\0'; exit 0 ;;
  # Popup body: a nested client on the hidden session, showing pane $2.
  # Detaching (prefix + d) brings back the list, on the same agent.
  --view)
    win="$(tmux display-message -p -t "$2" '#{window_id}')"
    name="$(pane_name "$2")"
    # Nesting needs TMUX unset; keep talking to this server, not the default one.
    sock="${TMUX%%,*}"
    sess="$(tmux display-message -p -t "$2" '#{session_name}')"
    ( unset TMUX; tmux -S "$sock" attach-session -t "=$sess" \; select-window -t "$win" )
    exec "$here/tmux-agents" --client "${3:-}" --select "$name" --scope "${4:-window}" --mode "${5:-sub}"
    ;;
  # Started by fzf on "start": keep the preview live by asking fzf (on its
  # --listen port) to refresh it. Ends when fzf exits and the port closes.
  --preview-loop)
    while curl -fs -XPOST "http://localhost:${FZF_PORT:?}" -d refresh-preview >/dev/null 2>&1; do
      sleep "${TMUX_AGENTS_PREVIEW_SECS:-0.5}"
    done
    exit 0
    ;;
  # fzf "d": after the tmux prefix key (within 2s), prefix + d closes the
  # list, like it leaves an agent's view; otherwise d is just typed.
  # Preview of a closed sub agent: what reopening it would bring back.
  --closed-info)
    n="${2#closed:}"
    printf '\033[1m%s\033[0m  closed, can be reopened\n\n' "$n"
    printf '  agent    %s\n  dir      %s\n  parent   %s\n  session  %s\n\n' \
      "$(record_get "$n" kind)" "$(record_get "$n" dir)" "$(record_get "$n" parent)" "$(record_get "$n" id)"
    printf 'enter: reopen it with its conversation, connected to %s\nctrl-o: reopen and jump there · ctrl-x: forget it\n' "$(record_get "$n" parent)"
    exit 0
    ;;
  # ctrl-x: close a live agent, or forget a closed one.
  --dismiss)
    require_tmux
    case "${2:-}" in
      closed:*) rm -f "$(sessions_dir)/${2#closed:}" ;;
      *) "$here/tmux-dismiss" "$(pane_name "$2")" ;;
    esac
    exit 0
    ;;
  --prefix-d)
    at="$(tmux show-options -gqv @tmux_agents_prefix_at)"
    tmux set-option -gu @tmux_agents_prefix_at 2>/dev/null || true
    if [ -n "$at" ] && [ $(( $(date +%s) - at )) -le 2 ]; then echo abort; else echo "put(d)"; fi
    exit 0
    ;;
  # ctrl-a remembers the named/sub view; ctrl-t changes only this picker
  # scope. Both preserve the other dimension in the prompt.
  --toggle|--toggle-scope)
    parse_prompt "${2:-}"
    if [ "$1" = --toggle ]; then
      if [ "$list_mode" = all ]; then list_mode=sub; else list_mode=all; fi
      tmux set-option -g @tmux_agents_list_mode "$list_mode"
    else
      if [ "$list_scope" = all ]; then list_scope=window; else list_scope=all; fi
    fi
    printf "change-prompt(%s)+reload('%s' --list)\n" "$(list_prompt "$list_mode" "$list_scope")" "$here/tmux-agents"
    exit 0
    ;;
  # status-right: "active subagents: N", plus how many rang for attention.
  --status)
    tmux list-panes -a -F '#{pane_id} #{?@parent,1,0} #{pane_dead} #{window_bell_flag} #{?#{==:#{@state},done},1,0}' | awk '
      $2 == 1 && !seen[$1]++ {
        if ($3 == 1 || $5 == 1) { d++; next }
        n++; if ($4 == 1) b++
      }
      END {
        printf "active subagents: %d", n
        if (b) printf " · %d needs you", b
        if (d) printf " · %d done", d
      }'
    exit 0
    ;;
  # alert-bell hook: tell every client when a hidden agent rings.
  --alert)
    is_agents_session "${2:-}" || exit 0
    for c in $(tmux list-clients -F '#{client_name}'); do
      is_agents_session "$(tmux display-message -p -c "$c" '#{session_name}')" && continue
      tmux display-message -c "$c" -d 5000 "agent ${3:-?} needs you (prefix + a)"
    done
    exit 0
    ;;
esac

client="" select="" scope=window mode=""
while [ $# -gt 0 ]; do
  case "$1" in
    --client) client="${2:-}"; shift 2 ;;
    --select) select="${2:-}"; shift 2 ;;
    --scope) scope="${2:-window}"; shift 2 ;;
    --mode) mode="${2:-sub}"; shift 2 ;;
    *) shift ;;
  esac
done
require_tmux
[ -n "$client" ] || client="$(tmux display-message -p '#{client_name}')"
command -v fzf >/dev/null 2>&1 || die "fzf is required"

self="$here/tmux-agents"
# Scope starts local on every fresh open; popup return passes both dimensions.
export TMUX_AGENTS_LIST_CLIENT="$client"
[ -n "$mode" ] || mode="$(tmux show-options -gqv @tmux_agents_list_mode)"
[ "$mode" = all ] || mode=sub
[ "$scope" = all ] || scope=window
prompt="$(list_prompt "$mode" "$scope")"
rows="$(list_agents "$mode" "$scope" "$client")"
# The tmux prefix (C-b -> ctrl-b) arms "d" to close the list: prefix + d.
prefix_keys=()
case "$(tmux show-options -gv prefix 2>/dev/null)" in
  C-[a-z]) pk="$(tmux show-options -gv prefix)"; pk="ctrl-${pk#C-}"
    prefix_keys=(--bind "$pk:execute-silent(tmux set-option -g @tmux_agents_prefix_at \$(date +%s))" --bind "d:transform:'$self' --prefix-d") ;;
esac
start=""
if [ -n "$select" ]; then
  n="$(printf '%s' "$rows" | awk -v RS='\036' -v s="$select" 'NR > 1 { sub(/^[^ ]+ +/, ""); if (index($0, s " ") == 1 || index($0, "\n" s " ")) { print NR - 1; exit } }')"
  [ -z "$n" ] || start="load:pos($n)+unbind(load)"
fi
out="$(printf '%s' "$rows" | tr '\036' '\0' | fzf --read0 --ansi --reverse --no-sort --header-lines=1 --with-nth=2.. --prompt="$prompt" \
  ${start:+--bind "$start"} \
  ${prefix_keys[@]+"${prefix_keys[@]}"} \
  --with-shell 'bash -c' \
  --listen --bind "start:execute-silent('$self' --preview-loop >/dev/null 2>&1 &)" \
  --footer="$(printf 'enter open · ^o jump (prefix+L back) · ^x dismiss\n^d clean done · ^a all/sub · ^t this/all windows · ^r refresh · prefix+d close')" --footer-border=rounded \
  --preview "case {1} in closed:*) '$self' --closed-info {1} ;; *) tmux capture-pane -ep -J -t {1} -S -300 ;; esac" --preview-window='right,55%,follow' \
  --bind "ctrl-x:execute-silent('$self' --dismiss {1})+reload('$self' --list)" \
  --bind "ctrl-r:reload('$self' --list)" \
  --bind "ctrl-d:execute('$here/tmux-dismiss' --done)+reload('$self' --list)" \
  --bind "enter:transform:printf 'print(enter)+print(%s)+accept' \"\$FZF_PROMPT\"" \
  --bind "ctrl-o:transform:printf 'print(ctrl-o)+print(%s)+accept' \"\$FZF_PROMPT\"" \
  --bind "ctrl-t:transform:'$self' --toggle-scope \"\$FZF_PROMPT\"" \
  --bind "ctrl-a:transform:'$self' --toggle \"\$FZF_PROMPT\"")" || exit 0

key="$(printf '%s\n' "$out" | sed -n 1p)"
parse_prompt "$(printf '%s\n' "$out" | sed -n 2p)"
pane="$(printf '%s\n' "$out" | sed -n 3p | awk '{ print $1 }')"
[ -n "$pane" ] || exit 0

# A closed sub agent: reopen it with its conversation, connected to its
# old parent if that is still open, then show it like any other.
case "$pane" in
  closed:*)
    name="${pane#closed:}"
    parent="$(record_get "$name" parent)"
    if ! msg="$("$here/tmux-spawn" --resume "$name" ${parent:+--parent "$parent"} 2>&1)"; then
      tmux display-message -c "$client" -d 6000 "$msg"
      exit 1
    fi
    pane="$(find_pane "$name")"
    [ -n "$pane" ] || exit 1
    ;;
esac
name="$(pane_name "$pane")"
session="$(tmux display-message -p -t "$pane" '#{session_name}')"

if [ "$key" != "ctrl-o" ] && is_agents_session "$session"; then
  # This script runs in a popup itself, so open the viewer once it closes.
  tmux run-shell -b "sleep 0.2; tmux display-popup -c '$client' -E -w 90% -h 90% -T ' $name  (prefix + d: back to the list) ' '$here/tmux-agents --view $pane $client $list_scope $list_mode'"
else
  tmux switch-client -c "$client" -t "$pane"
  tmux display-message -c "$client" -d 4000 "jumped to $name · prefix + L to go back"
fi
