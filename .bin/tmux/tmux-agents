#!/usr/bin/env bash
# Browse agent panes: live preview, open hidden ones in a popup, jump, dismiss.
set -euo pipefail
here="$(cd "$(dirname "$0")" && pwd)"
. "$here/lib.sh"

usage() {
  cat <<'EOF'
usage: tmux-agents [--client NAME]

Lists sub agents (spawned with tmux-spawn) with a live preview.
Bound to prefix + a.

  enter   open it: hidden agents in a popup (prefix + d closes), others jump
  ctrl-o  jump to it full screen (prefix + L jumps back)
  ctrl-x  dismiss (close the pane)
  ctrl-d  clean up every done or exited sub agent (asks first)
  ctrl-a  toggle between sub agents and every named pane
  ctrl-r  refresh
EOF
}

# One row per agent: ID NAME STATUS PARENT PROJECT. Sub agents only,
# unless $1 is "all" (then every named pane). ID is hidden by fzf.
list_agents() {
  local all="${1:-}" rows
  rows="$(tmux list-panes -a -F '#{pane_id}	#{@agent}	#{?pane_dead,exited,#{?#{==:#{@state},done},done,#{?window_bell_flag,needs-you,running}}}	#{?@parent,#{@parent},-}	#{session_name}' \
    | awk -F '\t' -v all="$all" '$2 != "" && (all == "all" || $4 != "-") && !seen[$1]++')"
  {
    printf 'ID\tNAME\tSTATUS\tPARENT\tPROJECT\n'
    printf '%s\n' "$rows" | while IFS="$(printf '\t')" read -r id name status parent session; do
      [ -n "$id" ] || continue
      pname="-"
      [ "$parent" = "-" ] || pname="$(pane_name "$parent")"
      is_agents_session "$session" && session="${session#"$AGENTS_PREFIX"-}"
      printf '%s\t%s\t%s\t%s\t%s\n' "$id" "$name" "$status" "${pname:--}" "$session"
    done
  } | column -t -s "$(printf '\t')"
}

# Two-line status bar while sub agents exist: the chip line on top, the
# user's own status line below. "on" saves their line in
# @tmux_agents_main_format; "off" puts it back.
chip_layout() {
  local cur main fps
  if [ "$1" = on ]; then
    cur="$(tmux show-options -gv 'status-format[0]')"
    case "$cur" in *"tmux-agents --chip"*|*"@chip"*) ;; *) tmux set-option -g @tmux_agents_main_format "$cur" ;; esac
    main="$(tmux show-options -gqv @tmux_agents_main_format)"
    fps="$(tmux show-options -gqv @tmux_agents_chip_fps)"
    tmux set-option -g 'status-format[1]' "$main"
    if [ "${fps:-10}" -gt 1 ] 2>/dev/null; then
      # Pushed by the chip daemon at $fps frames a second.
      # The #() part prints nothing; it restarts the daemon if it died.
      tmux set-option -g 'status-format[0]' "#{@chip}#($here/tmux-agents --chip-ensure)"
      tmux run-shell -b "'$here/tmux-agents' --chip-daemon"
    else
      # Re-run by tmux every status-interval (1s at most).
      tmux set-option -g 'status-format[0]' "#($here/tmux-agents --chip)"
    fi
    tmux set-option -g status 2
  else
    main="$(tmux show-options -gqv @tmux_agents_main_format)"
    [ -n "$main" ] || return 0
    tmux set-option -g 'status-format[0]' "$main"
    tmux set-option -gu 'status-format[1]'
    tmux set-option -g status on
  fi
}

# One per tmux server, started by chip_layout: rebuild the chip once a
# second, animate its spinner at @tmux_agents_chip_fps (default 10), and
# push it into @chip with a redraw. Exits once the chip line is gone.
chip_daemon() {
  local pid fps delay frames tick=0 last=-1 now template line c log
  pid="$(tmux show-options -gqv @tmux_agents_chip_pid)"
  if [ -n "$pid" ] && [ "$pid" != $$ ] && kill -0 "$pid" 2>/dev/null; then return 0; fi
  tmux set-option -g @tmux_agents_chip_pid $$
  # Two clients' --chip-ensure can start daemons in the same second; the
  # last one to register wins and the others leave.
  sleep 0.3
  [ "$(tmux show-options -gqv @tmux_agents_chip_pid)" = $$ ] || return 0
  # A long-running loop: one failing tmux call (say a client detaching
  # between list-clients and refresh-client) must not end it.
  set +e +o pipefail
  log="/tmp/tmux-agents-$(id -u)/chip-daemon.log"
  mkdir -p "$(dirname "$log")"
  exec 2>>"$log"
  fps="$(tmux show-options -gqv @tmux_agents_chip_fps)"
  case "$fps" in ''|*[!0-9]*) fps=10 ;; esac
  [ "$fps" -le 30 ] || fps=30
  delay="$(awk -v f="$fps" 'BEGIN { printf "%.3f", 1 / f }')"
  frames=(⠋ ⠙ ⠹ ⠸ ⠼ ⠴ ⠦ ⠧ ⠇ ⠏)
  while :; do
    now="$(date +%s)"
    if [ "$now" != "$last" ]; then
      case "$(tmux show-options -gv 'status-format[0]' 2>/dev/null)" in *"@chip"*) ;; *) echo "$(date '+%F %T') chip line gone, exiting" >&2; break ;; esac
      template="$(CHIP_SPIN=@@SPIN@@ chip)"
      last="$now"
    fi
    line="${template//@@SPIN@@/${frames[$((tick % 10))]}}"
    tmux set-option -g @chip "$line" 2>/dev/null || { echo "$(date '+%F %T') tmux server gone, exiting" >&2; break; }
    for c in $(tmux list-clients -F '#{client_name}' 2>/dev/null); do tmux refresh-client -S -t "$c" 2>/dev/null; done
    tick=$((tick + 1))
    sleep "$delay"
  done
  tmux set-option -gu @tmux_agents_chip_pid 2>/dev/null || true
  tmux set-option -gu @chip 2>/dev/null || true
}

# "stone-age" from agents-projects-stone-age, at most 10 characters.
short_project() {
  local p="${1#"$AGENTS_PREFIX"-}"
  p="${p#projects-}"; p="${p#project-}"
  [ "${#p}" -le 10 ] || p="${p:0:9}…"
  printf '%s' "$p"
}

# Long task names keep their start and end: seimu-jyaruga-map-audit -> seimu-j…map-audit
short_task() {
  [ "${#1}" -le 18 ] && { printf '%s' "$1"; return; }
  printf '%s…%s' "${1:0:7}" "${1:$((${#1} - 10))}"
}

# The chip, centred: one focus agent that rotates every 4s, then
# per-project counts. Agents waiting for permission take over the focus and turn red; past
# TMUX_AGENTS_BLINK_SECS (default 60) unanswered, they blink.
chip() {
  local now frames spin rows id name dead st session since activity state act
  local -a ids names states acts projs sinces
  now="$(date +%s)"
  frames=(⠋ ⠙ ⠹ ⠸ ⠼ ⠴ ⠦ ⠧ ⠇ ⠏)
  # CHIP_SPIN lets the chip daemon put a placeholder here and animate it.
  spin="${CHIP_SPIN:-${frames[$((now % 10))]}}"
  rows="$(tmux list-panes -a -F '#{pane_id}	#{@agent}	#{pane_dead}	#{?@state,#{@state},-}	#{session_name}	#{?@perm_since,#{@perm_since},-}	#{?@activity,#{@activity},-}	#{?@parent,1,0}' \
    | awk -F '\t' '$8 == 1 && $2 != "" && !seen[$1]++')"
  if [ -z "$rows" ]; then
    [ "$(tmux show-options -gv status)" != 2 ] || tmux run-shell -b "'$here/tmux-agents' --chip-layout off"
    return 0
  fi
  # State comes from what agents report: tmux-agent-report sets @activity,
  # its permission hooks set @perm_since, a reply to the parent sets done.
  while IFS="$(printf '\t')" read -r id name dead st session since activity _; do
    if [ "$dead" = 1 ]; then
      state=exited act="exited"
    elif [ "$since" != - ]; then
      state=perm act="NEEDS PERMISSION"
    elif [ "$st" = done ]; then
      state=done act="done"
    else
      state=work act="$activity"
      [ "$act" != - ] || act="starting"
    fi
    ids+=("$id"); names+=("$name"); states+=("$state"); acts+=("$act"); projs+=("$(short_project "$session")"); sinces+=("$since")
  done <<EOF
$rows
EOF

  # Per-project counts, in first-seen order.
  local out="" seen_projs=" " pj i n w d pm ex seg
  for pj in "${projs[@]}"; do
    case "$seen_projs" in *" $pj "*) continue ;; esac
    seen_projs="$seen_projs$pj "
    w=0 d=0 pm=0 ex=0
    for ((i = 0; i < ${#ids[@]}; i++)); do
      [ "${projs[i]}" = "$pj" ] || continue
      case "${states[i]}" in work) w=$((w+1)) ;; done) d=$((d+1)) ;; perm) pm=$((pm+1)) ;; exited) ex=$((ex+1)) ;; esac
    done
    seg="#[fg=colour250]$pj#[default]"
    [ "$pm" -eq 0 ] || seg="$seg #[fg=white,bg=red,bold] ⚠ $pm #[default]"
    [ "$w" -eq 0 ] || seg="$seg #[fg=colour117]$spin $w#[default]"
    [ "$d" -eq 0 ] || seg="$seg #[fg=colour114]✓ $d#[default]"
    [ "$ex" -eq 0 ] || seg="$seg #[fg=colour240]✗ $ex#[default]"
    out="${out:+$out #[fg=colour240]·#[default] }$seg"
  done

  # Focus: rotate through agents waiting for permission if any, else all.
  local -a cand=()
  for ((i = 0; i < ${#ids[@]}; i++)); do [ "${states[i]}" != perm ] || cand+=("$i"); done
  [ ${#cand[@]} -gt 0 ] || for ((i = 0; i < ${#ids[@]}; i++)); do cand+=("$i"); done
  i="${cand[$(( (now / 4) % ${#cand[@]} ))]}"
  local icon style focus
  case "${states[i]}" in
    perm) icon="⚠" ;;
    work) icon="$spin" ;;
    done) icon="✓" ;;
    exited) icon="✗" ;;
    *) icon="◦" ;;
  esac
  focus="$icon $(short_task "${names[i]}"): ${acts[i]}"
  if [ "${states[i]}" = perm ]; then
    style="fg=white,bg=red,bold"
    [ $((now - ${sinces[i]})) -lt "${TMUX_AGENTS_BLINK_SECS:-60}" ] || style="$style,blink"
    focus="#[$style] $focus #[default]"
  else
    focus="#[fg=colour252]$focus#[default]"
  fi
  # Focus, then per-project status, centred on the line.
  printf '#[align=centre]%s  #[fg=colour240]│#[default]  %s' "$focus" "$out"
}

case "${1:-}" in
  -h|--help) usage; exit 0 ;;
  # fzf reloads call this; the prompt says which view is showing.
  --chip) require_tmux; chip; exit 0 ;;
  --chip-layout) require_tmux; chip_layout "${2:-on}"; exit 0 ;;
  --chip-daemon) require_tmux; chip_daemon; exit 0 ;;
  # Run every status-interval from the chip line: restart a dead daemon.
  --chip-ensure)
    pid="$(tmux show-options -gqv @tmux_agents_chip_pid)"
    if [ -z "$pid" ] || ! kill -0 "$pid" 2>/dev/null; then
      tmux run-shell -b "'$here/tmux-agents' --chip-daemon"
    fi
    exit 0
    ;;
  --list) require_tmux; [ "${FZF_PROMPT:-}" = "all> " ] && list_agents all || list_agents; exit 0 ;;
  # Popup body: a nested client on the hidden session, showing this pane.
  --view)
    win="$(tmux display-message -p -t "$2" '#{window_id}')"
    # Nesting needs TMUX unset; keep talking to this server, not the default one.
    sock="${TMUX%%,*}"
    sess="$(tmux display-message -p -t "$2" '#{session_name}')"
    unset TMUX
    exec tmux -S "$sock" attach-session -t "=$sess" \; select-window -t "$win"
    ;;
  # status-right: "active subagents: N", plus how many rang for attention.
  --status)
    tmux list-panes -a -F '#{pane_id} #{?@parent,1,0} #{pane_dead} #{window_bell_flag} #{?#{==:#{@state},done},1,0}' | awk '
      $2 == 1 && !seen[$1]++ {
        if ($3 == 1 || $5 == 1) { d++; next }
        n++; if ($4 == 1) b++
      }
      END {
        printf "active subagents: %d", n
        if (b) printf " · %d needs you", b
        if (d) printf " · %d done", d
      }'
    exit 0
    ;;
  # alert-bell hook: tell every client when a hidden agent rings.
  --alert)
    is_agents_session "${2:-}" || exit 0
    for c in $(tmux list-clients -F '#{client_name}'); do
      is_agents_session "$(tmux display-message -p -c "$c" '#{session_name}')" && continue
      tmux display-message -c "$c" -d 5000 "agent ${3:-?} needs you (prefix + a)"
    done
    exit 0
    ;;
esac

client=""
if [ "${1:-}" = "--client" ]; then client="${2:-}"; fi
require_tmux
[ -n "$client" ] || client="$(tmux display-message -p '#{client_name}')"
command -v fzf >/dev/null 2>&1 || die "fzf is required"

self="$here/tmux-agents"
out="$(list_agents | fzf --reverse --no-sort --header-lines=1 --with-nth=2.. --prompt='agents> ' \
  --with-shell 'bash -c' \
  --footer="$(printf 'enter open · ^o jump (prefix+L back) · ^x dismiss\n^d clean done · ^a all/sub · ^r refresh')" --footer-border=rounded \
  --expect=ctrl-o \
  --preview 'tmux capture-pane -ep -J -t {1} -S -300' --preview-window='right,55%,follow' \
  --bind "ctrl-x:execute-silent('$here/tmux-dismiss' {2})+reload('$self' --list)" \
  --bind "ctrl-r:reload('$self' --list)" \
  --bind "ctrl-d:execute('$here/tmux-dismiss' --done)+reload('$self' --list)" \
  --bind "ctrl-a:transform:[ \"\$FZF_PROMPT\" = 'all> ' ] && echo \"change-prompt(agents> )+reload('$self' --list)\" || echo \"change-prompt(all> )+reload('$self' --list)\"")" || exit 0

key="$(printf '%s\n' "$out" | sed -n 1p)"
pane="$(printf '%s\n' "$out" | sed -n 2p | awk '{ print $1 }')"
[ -n "$pane" ] || exit 0
name="$(pane_name "$pane")"
session="$(tmux display-message -p -t "$pane" '#{session_name}')"

if [ "$key" != "ctrl-o" ] && is_agents_session "$session"; then
  # This script runs in a popup itself, so open the viewer once it closes.
  tmux run-shell -b "sleep 0.2; tmux display-popup -c '$client' -E -w 90% -h 90% -T ' $name  (prefix + d to close) ' '$here/tmux-agents --view $pane'"
else
  tmux switch-client -c "$client" -t "$pane"
  tmux display-message -c "$client" -d 4000 "jumped to $name · prefix + L to go back"
fi
