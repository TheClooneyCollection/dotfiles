#!/usr/bin/env bash
# Close an agent pane (and its window if it was the only pane).
set -euo pipefail
. "$(dirname "$0")/lib.sh"

# Agents pass --from ME and may only close their own sub agents.
FROM_PANE=""
[ "${1:-}" = "--from" ] && { FROM_PANE="${2:-}"; shift 2; }

case "${1:-}" in
  ''|-h|--help) echo "usage: tmux-dismiss [--from ME] <name> | --done  (closes panes and their transcripts)"; [ -n "${1:-}" ]; exit $? ;;
  # Close every done or exited sub agent, after asking.
  --done)
    require_tmux
    rows="$(tmux list-panes -a -F '#{pane_id} #{@agent} #{?pane_dead,exited,#{?@state,#{@state},-}} #{?@parent,1,0}' \
      | awk '$4 == 1 && ($3 == "done" || $3 == "exited") && !seen[$1]++ { print $1, $2, $3 }')"
    if [ -z "$rows" ]; then
      echo "No done or exited sub agents."
      sleep 1
      exit 0
    fi
    echo "Dismiss these sub agents and their transcripts?"
    printf '%s\n' "$rows" | awk '{ printf "  %-32s %s\n", $2, $3 }'
    printf 'Close %s pane(s)? [y/N] ' "$(printf '%s\n' "$rows" | wc -l | tr -d ' ')"
    read -r answer </dev/tty || answer=""
    case "$answer" in y|Y|yes) ;; *) echo "Nothing closed."; sleep 0.5; exit 0 ;; esac
    printf '%s\n' "$rows" | while read -r pane _; do note_closed "$pane"; tmux kill-pane -t "$pane"; done
    refresh_labels
    exit 0
    ;;
esac

require_tmux
pane="$(find_pane "$1")"
[ -n "$pane" ] || die "no agent named '$1'"
closer=""
if [ -n "$FROM_PANE" ]; then
  closer="$(self_pane)"
  [ "$(tmux display-message -p -t "$pane" '#{@parent}')" = "$closer" ] \
    || die "'$1' is not your sub agent; you can only close agents you spawned"
fi
note_closed "$pane" "$closer"
tmux kill-pane -t "$pane"
refresh_labels
echo "dismissed $1 ($pane)"
