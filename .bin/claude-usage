#!/usr/bin/env python3
"""Sum Claude Code token usage from local transcripts, by project, day, model or agent."""
import argparse
import json
import re
from collections import defaultdict
from datetime import datetime, timedelta, timezone
from pathlib import Path

FIELDS = ("input_tokens", "output_tokens", "cache_read_input_tokens", "cache_creation_input_tokens")
HEADERS = ("input", "output", "cache read", "cache write")
# The receiver of the first tmux-ask message a session gets is that agent's name.
AGENT_NAME = re.compile(r"\[(?:request|notice|reply) from \S+ to ([\w.~]+-\S+) via tmux-ask")
WORKTREE = re.compile(r"/\.?worktrees/.*$")


def user_text(message):
    content = message.get("content")
    if isinstance(content, str):
        return content
    if isinstance(content, list):
        return "\n".join(block.get("text", "") for block in content
                         if isinstance(block, dict) and block.get("type") == "text")
    return ""


def scan(root, since):
    """Return (usage records, session id -> agent name)."""
    seen, rows, names = set(), [], {}
    for path in root.rglob("*.jsonl"):
        with path.open(errors="replace") as f:
            for line in f:
                try:
                    entry = json.loads(line)
                except json.JSONDecodeError:
                    continue
                message = entry.get("message") or {}
                session = entry.get("sessionId") or path.stem
                # Skill text loaded into a session is a meta entry and quotes "from X to Y" examples.
                if (entry.get("type") == "user" and not entry.get("isMeta")
                        and session not in names and "via tmux-ask" in line):
                    match = AGENT_NAME.search(user_text(message))
                    if match:
                        names[session] = match.group(1)
                usage = message.get("usage")
                stamp = entry.get("timestamp")
                if not usage or not stamp:
                    continue
                # One API response is logged once per content block; count it once.
                key = entry.get("requestId") or message.get("id") or entry.get("uuid")
                if key in seen:
                    continue
                seen.add(key)
                when = datetime.fromisoformat(stamp.replace("Z", "+00:00")).astimezone()
                if when >= since:
                    rows.append((entry, message, usage, when, session))
    return rows, names


def project_name(entry):
    cwd = WORKTREE.sub("", entry.get("cwd") or "?")
    home = str(Path.home())
    return "~" + cwd[len(home):] if cwd.startswith(home) else cwd


def request_columns(row, count):
    # Context read per request: everything except output tokens.
    context = row[0] + row[2] + row[3]
    return f"  {count:>9,}  {context // max(count, 1):>11,}"


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--days", type=int, default=7, help="look back this many days (default 7)")
    parser.add_argument("--by", choices=("project", "day", "model", "project-day", "agent", "session"),
                        default="project-day")
    parser.add_argument("--today", action="store_true", help="only count usage since local midnight")
    parser.add_argument("--limit", type=int, default=0, help="show only the top N rows")
    args = parser.parse_args()

    since = datetime.now(timezone.utc).astimezone() - timedelta(days=args.days)
    if args.today:
        since = datetime.now().astimezone().replace(hour=0, minute=0, second=0, microsecond=0)
    rows, names = scan(Path.home() / ".claude" / "projects", since)
    totals = defaultdict(lambda: [0] * len(FIELDS))
    requests = defaultdict(int)
    for entry, message, usage, when, session in rows:
        project = project_name(entry)
        agent = names.get(session, "(unnamed)")
        key = {
            "project": (project,),
            "day": (when.strftime("%Y-%m-%d"),),
            "model": (message.get("model", "?"),),
            "project-day": (when.strftime("%Y-%m-%d"), project),
            "agent": (agent, project),
            "session": (session[:8], agent, project),
        }[args.by]
        row = totals[key]
        requests[key] += 1
        for i, field in enumerate(FIELDS):
            row[i] += usage.get(field) or 0

    if not totals:
        print(f"no usage in the last {args.days} days")
        return
    if args.by in ("day", "project-day"):
        order = sorted(totals.items())
    else:
        order = sorted(totals.items(), key=lambda item: -sum(item[1]))
    grand = [sum(column) for column in zip(*totals.values())]
    grand_requests = sum(requests.values())
    if args.limit:
        order = order[:args.limit]
    width = max(len("  ".join(key)) for key, _ in order)
    print(f"{args.by:<{width}}  " + "  ".join(f"{h:>12}" for h in HEADERS)
          + f"  {'total':>13}  {'requests':>9}  {'avg context':>11}")
    for key, row in order:
        print(f"{'  '.join(key):<{width}}  " + "  ".join(f"{n:>12,}" for n in row)
              + f"  {sum(row):>13,}" + request_columns(row, requests[key]))
    print(f"{'total':<{width}}  " + "  ".join(f"{n:>12,}" for n in grand)
          + f"  {sum(grand):>13,}" + request_columns(grand, grand_requests))


if __name__ == "__main__":
    main()
