#!/usr/bin/env bash

# tmux-chain — start an agent chain in a new project window.
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: tmux-chain [dir] [--no-save] [--target session[:index]] [--name name]

Start a chain in a new tmux window. With no dir, pick from $PWD (default)
then saved projects, built-in projects and Git repos using fzf.
An explicit dir skips the picker. Paths under HOME are displayed with ~.
Without a terminal or fzf, warn and use $PWD. Esc cancels without saving.
Print the new pane ID to stdout. Without --target, run inside tmux and
focus the new window. With --target, leave the new window detached.
Successful launches save the directory unless --no-save is given.

Options:
  --include-worktrees  include scanned repos whose .git is a file
  --no-save       do not add the directory to the projects file
  --save          save the canonical directory (default; compatibility option)
  --target        destination session, optionally with a window index
  --name          window name (default: directory basename)
  -h, --help      show this help
  --              treat remaining arguments as the directory

Environment:
  TMUX_MAIN_SEQUENCE_AGENT   whole shell command (default: tmux-agents start claude -- "start the chain")
  TMUX_MAIN_SEQUENCE_CONFIG  projects file (default: ~/.config/tmux-main-sequence/projects)
  TMUX_MAIN_SEQUENCE_SOCKET  named tmux socket, passed with -L
  TMUX_CHAIN_SCAN_ROOT       scan Git repos at depths 1 and 2 (default: ~/Source/Projects)
                             skip worktrees by default; stop at any repo

Saved paths use ~ for HOME. Existing paths are resolved relative to the
current directory for deduplication; blank lines and comments are ignored.
EOF
}

fail() { printf 'tmux-chain: %s\n' "$*" >&2; exit 1; }
invalid() { printf 'tmux-chain: %s\n' "$*" >&2; usage >&2; exit 2; }

DIR=$PWD
HAVE_DIR=0
SAVE=1
INCLUDE_WORKTREES=0
TARGET=
NAME=
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    --include-worktrees) INCLUDE_WORKTREES=1; shift ;;
    --save) shift ;;
    --no-save) SAVE=0; shift ;;
    --target|--name)
      [[ $# -ge 2 && -n $2 && $2 != --* ]] || invalid "$1 requires a value"
      case "$1" in
        --target) TARGET=$2 ;;
        --name) NAME=$2 ;;
      esac
      shift 2
      ;;
    --) shift; break ;;
    -*) invalid "unknown option: $1" ;;
    *)
      [[ $HAVE_DIR -eq 0 ]] || invalid "only one directory is allowed"
      DIR=$1; HAVE_DIR=1; shift
      ;;
  esac
done
for ARG in "$@"; do
  [[ $HAVE_DIR -eq 0 ]] || invalid "only one directory is allowed"
  DIR=$ARG; HAVE_DIR=1
done

# Expand only the supported home shorthand; never evaluate config contents.
canonical_dir() {
  local path=$1
  case "$path" in
    '~') path=$HOME ;;
    '~/'*) path=$HOME/${path#\~/} ;;
  esac
  (CDPATH= cd -- "$path" 2>/dev/null && pwd -P)
}

CONFIG=${TMUX_MAIN_SEQUENCE_CONFIG:-$HOME/.config/tmux-main-sequence/projects}

# Share the same parsing rules between the picker and --save.
saved_dirs() {
  local entry existing
  [[ -f $CONFIG ]] || return 0
  while IFS= read -r entry || [[ -n $entry ]]; do
    entry="${entry#"${entry%%[![:space:]]*}"}"
    entry="${entry%"${entry##*[![:space:]]}"}"
    [[ -z $entry || $entry == \#* ]] && continue
    existing=$(canonical_dir "$entry") || continue
    [[ $existing != *$'\n'* ]] || continue
    printf '%s\n' "$existing"
  done < "$CONFIG"
}

# Only inspect two levels, and do not descend into a repository.
scanned_dirs() (
  local root first second
  root=$(canonical_dir "${TMUX_CHAIN_SCAN_ROOT:-$HOME/Source/Projects}") || return 0
  shopt -s nullglob dotglob
  for first in "$root"/*; do
    [[ -d $first ]] || continue
    if [[ -d $first/.git || -f $first/.git ]]; then
      if [[ -d $first/.git || $INCLUDE_WORKTREES -eq 1 ]]; then
        printf '%s\n' "$first"
      fi
      continue
    fi
    for second in "$first"/*; do
      [[ -d $second && ( -d $second/.git || ( $INCLUDE_WORKTREES -eq 1 && -f $second/.git ) ) ]] || continue
      printf '%s\n' "$second"
    done
  done
)

[[ -n $DIR ]] || fail "directory must not be empty"
DIR=$(canonical_dir "$DIR") || fail "directory does not exist or is inaccessible"
[[ $DIR != *$'\n'* ]] || fail "directory names containing newlines are not supported"
if [[ $HAVE_DIR -eq 0 ]]; then
  if [[ ! -t 0 || ! -t 2 ]]; then
    printf 'tmux-chain: no terminal; using current directory\n' >&2
  elif ! command -v fzf >/dev/null 2>&1; then
    printf 'tmux-chain: fzf is not on PATH; using current directory\n' >&2
  else
    # Preserve order so the current directory is the initial choice.
    SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
    # shellcheck source=.bin/tmux-projects.sh
    source "$SCRIPT_DIR/tmux-projects.sh"
    HOME_DIR=$(canonical_dir "$HOME")
    CHOICES=("$DIR")
    while IFS= read -r ENTRY; do
      ENTRY=$(canonical_dir "$ENTRY") || continue
      [[ $ENTRY != *$'\n'* ]] || continue
      FOUND=0
      for EXISTING in "${CHOICES[@]}"; do
        if [[ $EXISTING == "$ENTRY" ]]; then FOUND=1; break; fi
      done
      [[ $FOUND -eq 1 ]] || CHOICES+=("$ENTRY")
    done < <(saved_dirs; printf '%s\n' "${TMUX_BUILTIN_PROJECT_DIRS[@]}"; scanned_dirs)
    LABELS=()
    for ENTRY in "${CHOICES[@]}"; do
      case "$ENTRY" in
        "$HOME_DIR") ENTRY='~' ;;
        "$HOME_DIR"/*) ENTRY="~/${ENTRY#"$HOME_DIR"/}" ;;
      esac
      LABELS+=("$ENTRY")
    done
    STATUS=0
    SELECTED=$(printf '%s\n' "${LABELS[@]}" | fzf --no-sort --no-multi --layout=reverse --query='' --prompt='Project> ') || STATUS=$?
    case $STATUS in
      0) [[ -n $SELECTED ]] || exit 0 ;;
      1|130) exit 0 ;;
      *) fail "fzf failed (exit $STATUS)" ;;
    esac
    FOUND=0
    for INDEX in "${!LABELS[@]}"; do
      if [[ ${LABELS[$INDEX]} == "$SELECTED" ]]; then
        DIR=${CHOICES[$INDEX]}
        FOUND=1
        break
      fi
    done
    [[ $FOUND -eq 1 ]] || fail "fzf returned an unknown project"
  fi
fi
[[ -n $TARGET || -n ${TMUX:-} ]] || fail "run inside tmux or specify --target session[:index]"

TMUX_CMD=(tmux)
[[ -z ${TMUX_MAIN_SEQUENCE_SOCKET:-} ]] || TMUX_CMD+=(-L "$TMUX_MAIN_SEQUENCE_SOCKET")
WINDOW_ARGS=(-P -F '#{pane_id}')
if [[ -z $TARGET ]]; then
  TARGET=$("${TMUX_CMD[@]}" display-message -p '#{session_id}')
else
  WINDOW_ARGS+=(-d)
fi
[[ $TARGET == *:* ]] || TARGET=$TARGET:
[[ -n $NAME ]] || NAME=${DIR##*/}
[[ -n $NAME ]] || NAME=/
AGENT=${TMUX_MAIN_SEQUENCE_AGENT:-'tmux-agents start claude -- "start the chain"'}

PANE=$("${TMUX_CMD[@]}" new-window "${WINDOW_ARGS[@]}" -t "$TARGET" -n "$NAME" -c "$DIR")
"${TMUX_CMD[@]}" set-option -w -t "$PANE" automatic-rename off
"${TMUX_CMD[@]}" set-option -w -t "$PANE" allow-rename off
"${TMUX_CMD[@]}" send-keys -t "$PANE" -l -- "$AGENT"
"${TMUX_CMD[@]}" send-keys -t "$PANE" Enter
# Persist only after the window and its launch command were created successfully.
if [[ $SAVE -eq 1 ]]; then
  mkdir -p -- "$(dirname -- "$CONFIG")"
  touch -- "$CONFIG"
  FOUND=0
  while IFS= read -r EXISTING; do
    if [[ $EXISTING == "$DIR" ]]; then FOUND=1; break; fi
  done < <(saved_dirs)
  if [[ $FOUND -eq 0 ]]; then
    SAVED=$DIR
    HOME_DIR=$(canonical_dir "$HOME")
    case "$SAVED" in
      "$HOME_DIR") SAVED='~' ;;
      "$HOME_DIR"/*) SAVED="~/${SAVED#"$HOME_DIR"/}" ;;
    esac
    # Keep a final unterminated entry separate from the appended path.
    if [[ -s $CONFIG && -n $(tail -c 1 -- "$CONFIG") ]]; then printf '\n' >> "$CONFIG"; fi
    printf '%s\n' "$SAVED" >> "$CONFIG"
  fi
fi

printf '%s\n' "$PANE"
