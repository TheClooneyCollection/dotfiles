#!/usr/bin/env bash
# Browse windows across all sessions, with the active pane as the preview.
set -euo pipefail

client=''
tmux_args=()
while [ "$#" -gt 0 ]; do
  case "$1" in
    --client|-L)
      [ "$#" -ge 2 ] || { printf 'Missing value for %s\n' "$1" >&2; exit 1; }
      if [ "$1" = --client ]; then client="$2"; else tmux_args=(-L "$2"); fi
      shift 2
      ;;
    *) printf 'Usage: tmux-window-picker [--client NAME] [-L SOCKET]\n' >&2; exit 1 ;;
  esac
done

if ! command -v fzf >/dev/null 2>&1; then
  printf 'tmux-window-picker: fzf is required.\n' >&2
  exit 1
fi
[ -n "$client" ] || client="$(tmux ${tmux_args[@]+"${tmux_args[@]}"} display-message -p '#{client_name}')"
[ -n "$client" ] || { printf 'tmux-window-picker: no client specified.\n' >&2; exit 1; }

current="$(tmux ${tmux_args[@]+"${tmux_args[@]}"} display-message -c "$client" -p '#{session_id}')"

# Keep stable session/window IDs hidden, including the session for linked windows.
# Grouped sessions share windows, so list each window once per group, from the
# client's own session when it is in the group. Skip tmux-agents' hidden
# agents-* sessions, and pad the searched label so the pane counts line up; the
# tab after the padding keeps --nth on the label.
rows="$(tmux ${tmux_args[@]+"${tmux_args[@]}"} list-windows -a -F $'#{session_id}:#{window_id}\t#{session_name}\t#{session_name}:#{window_index} #{window_name}\t#{window_panes}\t#{session_id}\t#{window_id}\t#{session_group}' |
  awk -F '\t' -v current="$current" '
    $2 ~ /^agents-/ { next }
    { key = ($7 != "" ? $7 : $5) SUBSEP $6
      if (key in row) { if ($5 != current) next; i = row[key] }
      else { i = row[key] = ++n }
      id[i] = $1; label[i] = $3; panes[i] = $4 }
    END {
      for (i = 1; i <= n; i++) if (length(label[i]) > width) width = length(label[i])
      for (i = 1; i <= n; i++)
        printf "%s\t%-*s\t[%d %s]\n", id[i], width, label[i], panes[i], (panes[i] == 1 ? "pane" : "panes")
    }')"
[ -n "$rows" ] || { printf 'tmux-window-picker: no windows to show.\n' >&2; exit 0; }
# Quote the command for fzf's shell; {1} is the hidden target, quoted by fzf.
printf -v preview '%q ' tmux ${tmux_args[@]+"${tmux_args[@]}"} capture-pane -ep -J -S -300 -t
selection="$(printf '%s\n' "$rows" | fzf --no-multi --reverse \
  --delimiter=$'\t' --with-nth=2.. --nth=1 --tiebreak=begin,index \
  --prompt='windows> ' \
  --header='enter switch · esc cancel' --with-shell='bash -c' \
  --preview="${preview}{1}" --preview-window='right,60%,follow')" || exit 0
[ -n "$selection" ] || exit 0
target="${selection%%$'\t'*}"
tmux ${tmux_args[@]+"${tmux_args[@]}"} switch-client -c "$client" -t "$target"
